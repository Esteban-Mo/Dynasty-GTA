generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Interior {
  id               Int          @id @default(autoincrement())
  title            String
  listImages       String
  typeId           Int
  furniture        Boolean
  unfurnished      Boolean
  description      String?
  stockage         Int?
  rooms            Int?
  bedRooms         Int?
  floor            Int?
  parkingSpots     Int?
  displayed        Boolean      @default(true)
  minRentalPrice   Float?
  maxRentalPrice   Float?
  minPurchasePrice Float?
  maxPurchasePrice Float?
  type             TypeInterior @relation(fields: [typeId], references: [id])
}

model TypeInterior {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  icon      String
  order     Int        @default(autoincrement())
  interiors Interior[]
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String
  coordinates Json
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  order     Int      @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

model Pin {
  id        Int      @id @default(autoincrement())
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
