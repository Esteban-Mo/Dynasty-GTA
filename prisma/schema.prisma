// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Interior {
  id           Int          @id @default(autoincrement())
  title        String
  listImages   Json
  type         TypeInterior @relation(fields: [typeId], references: [id])
  typeId       Int
  furniture    Boolean
  unfurnished  Boolean
  description  String?
  stockage     Int?
  rooms        Int?
  bedRooms     Int?
  floor        Int?
  parkingSpots Int?
}

model TypeInterior {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  icon      String
  order     Int        @default(autoincrement())
  interiors Interior[]
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String
  coordinates Json
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
